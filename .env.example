# FRED API
FRED_API_KEY=your_fred_api_key_here

# Zillow (RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=zillow-com1.p.rapidapi.com

# Census Bureau
CENSUS_API_KEY=your_census_api_key_here

# Walk Score
WALKSCORE_API_KEY=your_walkscore_api_key_here

# Object Storage (MinIO local / GCS production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your_access_key_here
STORAGE_SECRET_KEY=your_secret_key_here
STORAGE_BUCKET=housing-platform-raw

# Snowflake (production only)
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_user_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=HOUSING_PLATFORM
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=your_role_here

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

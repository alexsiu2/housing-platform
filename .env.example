# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Data source API keys (all free) ---------------------------------------
FRED_API_KEY=your_fred_api_key_here
CENSUS_API_KEY=your_census_api_key_here
BLS_API_KEY=your_bls_api_key_here
# Reddit app credentials (Phase 6)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=rpof-research-bot/0.1
# Claude API for the weekly market outlook (Phase 6)
ANTHROPIC_API_KEY=

# --- Object storage --------------------------------------------------------
# Local SeaweedFS from docker/compose.yaml. Inside containers the endpoint is
# overridden to http://seaweedfs:8333 automatically.
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY=rpof-local
STORAGE_SECRET_KEY=rpof-local-secret
STORAGE_REGION=us-east-1
RAW_BUCKET=rpof-raw
LAKE_BUCKET=rpof-lake

# --- Local warehouse -------------------------------------------------------
DUCKDB_PATH=../data/rpof.duckdb

# --- Airflow (local) -------------------------------------------------------
# On Linux set this to the output of `id -u` so mounted files aren't owned by root.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

{
  "type": "record",
  "name": "NewsItem",
  "namespace": "rpof.news.v1",
  "doc": "One news item from any source (design doc 9.2). Evolve backward-compatibly only: new fields must be nullable with a default.",
  "fields": [
    {"name": "source", "type": {"type": "enum", "name": "Source", "symbols": ["rss", "reddit", "gdelt"]}},
    {"name": "source_id", "type": "string", "doc": "Stable id within the source (RSS guid/link hash, Reddit post id, GKG record id)."},
    {"name": "url", "type": "string"},
    {"name": "title", "type": ["null", "string"], "default": null},
    {"name": "body_snippet", "type": ["null", "string"], "default": null, "doc": "Feed summary only, never scraped article text; capped at 1,000 characters."},
    {"name": "published_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
    {"name": "fetched_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "subreddit", "type": ["null", "string"], "default": null},
    {"name": "feed_name", "type": ["null", "string"], "default": null},
    {"name": "geo_hint", "type": ["null", "string"], "default": null, "doc": "GDELT: 'Full name|ADM1|lat|long' per US city, ';'-separated."},
    {"name": "engagement", "type": ["null", "long"], "default": null, "doc": "Reddit score + comments."},
    {"name": "tone", "type": ["null", "double"], "default": null, "doc": "GDELT average tone (-100..100)."},
    {"name": "themes", "type": {"type": "array", "items": "string"}, "default": [], "doc": "GDELT housing themes matched."}
  ]
}
